shell-integration = fish

term = xterm-ghostty
theme = catppuccin-frappe

# ── Appearance ────────────────────────────────────────
background-opacity = 0.88
background-blur-radius = 32

font-family = "Monaspace Neon"
font-family = "Hack Nerd Font Mono"
font-feature = calt, ss01, ss02, ss03, ss04, ss05, ss06, ss07, ss08
font-size = 11
font-thicken = true

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-color = #85c1dc

# Selection
selection-invert-fg-bg = false

# ── Window ────────────────────────────────────────────
macos-non-native-fullscreen = true
macos-titlebar-style = hidden
macos-icon = glass

window-decoration = true
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# ── Interaction ───────────────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 0.5

# ── Quick terminal (dropdown) ─────────────────────────
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15
quick-terminal-space-behavior = remain

# ── Misc ──────────────────────────────────────────────
resize-overlay = never
unfocused-split-opacity = 0.75
initial-window = false
confirm-close-surface = false

# ── Keybindings ───────────────────────────────────────
# Global: quick terminal toggle
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Tab navigation
keybind = ctrl+b=previous_tab
keybind = ctrl+n=next_tab
keybind = ctrl+shift+b=move_tab:-1
keybind = ctrl+shift+n=move_tab:+1

# Split creation (Ghostty native)
keybind = ctrl+;=new_split:up
keybind = ctrl+'=new_split:right

# Split navigation (vim-style)
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right
