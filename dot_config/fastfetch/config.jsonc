{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "macos_small",
        "color": { "1": "cyan", "2": "blue" },
        "padding": { "top": 1, "left": 2 },
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "cyan", "title": "blue" },
    },
    "modules": [
        {
            "type": "title",
            "color": { "user": "blue", "host": "cyan" },
        },
        "separator",
        { "type": "os", "key": "  os", "keyColor": "blue" },
        { "type": "kernel", "key": "  kernel", "keyColor": "cyan" },
        { "type": "uptime", "key": "  uptime", "keyColor": "blue" },
        { "type": "shell", "key": "  shell", "keyColor": "cyan" },
        { "type": "terminal", "key": "  term", "keyColor": "blue" },
        "break",
        { "type": "cpu", "key": "  cpu", "keyColor": "cyan" },
        { "type": "memory", "key": "  mem", "keyColor": "blue" },
        { "type": "disk", "key": "  disk", "keyColor": "cyan", "folders": "/" },
        "break",
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
    ],
}
