{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/bash

# .prototools hash: {{ include "dot_proto/dot_prototools" | sha256sum }}

set -euo pipefail

echo "Installing proto toolchain..."

PROTO_HOME="${HOME}/.local/share/proto"
export PATH="${PROTO_HOME}/shims:${PROTO_HOME}/bin:${PATH}"

if ! command -v proto &>/dev/null; then
    bash <(curl -fsSL https://moonrepo.dev/install/proto.sh) --yes
fi

proto use --yes

echo "Proto toolchain installation completed."
{{- end }}
