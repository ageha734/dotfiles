{
    "[dockercompose]": {
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
            "comments": false,
            "other": true,
            "strings": true
        },
        "editor.tabSize": 2
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[go]": {
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.snippetSuggestions": "none"
    },
    "accessibility.signals.terminalBell": {
        "sound": "on"
    },
    "breadcrumbs.enabled": true,
    "claudeCode.disableLoginPrompt": true,
    "claudeCode.preferredLocation": "sidebar",
    "coderabbit.agentType": "Claude Code",
    "cursor.composer.usageSummaryDisplay": "never",
    "database-client.autoSync": true,
    "datadog.codeSecurity.notification.suppressOnboarding": true,
    "datadog.connection.oauth.setup.domain": "dmm-pf.datadoghq.com",
    "datadog.cursor.notification.suppressMcpMigrationMessage": true,
    "datadog.timeRange.setup.timeFrame": "15m",
    "diffEditor.codeLens": true,
    "diffEditor.experimental.useTrueInlineView": true,
    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.wordWrap": "off",
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.enabled": true,
    "editor.codeActionsOnSave": {},
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "block",
    "editor.dragAndDrop": false,
    "editor.fontFamily": "'Fira Code', Hasklig, Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 11.5,
    "editor.guides.bracketPairs": false,
    "editor.guides.indentation": false,
    "editor.inlayHints.enabled": "off",
    "editor.minimap.enabled": false,
    "editor.minimap.maxColumn": 80,
    "editor.minimap.showSlider": "always",
    "editor.renderControlCharacters": true,
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "all",
    "editor.showFoldingControls": "always",
    "editor.smoothScrolling": true,
    "editor.suggestSelection": "first",
    "editor.wordSegmenterLocales": "ja",
    "editor.wordWrap": "off",
    "editor.wrappingIndent": "indent",
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "files.autoGuessEncoding": true,
    "files.candidateGuessEncodings": [
        "utf8",
        "shiftjis",
        "eucjp"
    ],
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/.bloop": true,
        "**/.metals": true
    },
    "git.autoRepositoryDetection": "openEditors",
    "git.autofetch": false,
    "git.autorefresh": false,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "git.ignoreRebaseWarning": true,
    "git.pruneOnFetch": true,
    "git.replaceTagsWhenPull": true,
    "git.suggestSmartCommit": false,
    "git.useEditorAsCommitInput": false,
    "github-actions.use-enterprise": true,
    "github.gitProtocol": "ssh",
    "go.coverOnSave": true,
    "go.coverageDecorator": {
        "coveredGutterStyle": "blockgreen",
        "type": "gutter",
        "uncoveredGutterStyle": "blockred"
    },
    "go.languageServerExperimentalFeatures": {
        "autoComplete": true,
        "diagnostics": true,
        "documentSymbols": true,
        "findReferences": true,
        "format": true,
        "goToDefinition": true,
        "goToImplementation": true,
        "goToTypeDefinition": true,
        "hover": true,
        "rename": true,
        "signatureHelp": true,
        "workspaceSymbols": true
    },
    "go.lintFlags": [
        "--fast"
    ],
    "go.lintTool": "golangci-lint",
    "go.toolsManagement.autoUpdate": true,
    "go.useLanguageServer": true,
    "gopls": {
        "formatting.gofumpt": true
    },
    "hediet.vscode-drawio.appearance": "light",
    "hediet.vscode-drawio.resizeImages": null,
    "hediet.vscode-drawio.theme": "atlas",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "openapi.approvedHostnames": [],
    "openapi.cliDirectoryOverride": "",
    "openapi.docker": {
        "replaceLocalhost": true,
        "useHostNetwork": true
    },
    "openapi.platformAuditRuntime": "platform",
    "openapi.platformAuthType": "api-token",
    "openapi.platformConformanceScanImage": "42crunch/scand-agent:v2",
    "openapi.platformConformanceScanProxy": "",
    "openapi.platformConformanceScanRuntime": "cli",
    "openapi.platformMandatoryTags": "",
    "openapi.platformRepository": "https://repo.42crunch.com/downloads",
    "openapi.platformServices": "",
    "openapi.platformTemporaryCollectionName": "IDE Temp Collection",
    "openapi.platformUrl": "https://platform.42crunch.com",
    "openapi.securityAuditToken": "",
    "redhat.telemetry.enabled": true,
    "scm.alwaysShowRepositories": true,
    "scm.compactFolders": false,
    "scm.defaultViewMode": "tree",
    "scm.diffDecorationsGutterWidth": 5,
    "scm.graph.badges": "all",
    "scm.inputFontFamily": "editor",
    "scm.inputFontSize": 14,
    "search.showLineNumbers": true,
    "security.workspace.trust.enabled": true,
    "sonarlint.focusOnNewCode": false,
    "sonarlint.ideLabsEnabled": true,
    "sonarlint.pathToNodeExecutable": "~/.local/share/proto/tools/node/25.2.1/bin/node",
    "sonarlint.rules": {
        "go:S100": {
            "level": "off"
        },
        "go:S1192": {
            "level": "off"
        },
        "go:S3776": {
            "level": "off"
        },
        "go:S4144": {
            "level": "off"
        }
    },
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "docker-desktop"
    ],
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.enableImages": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.fontFamily": "HackGen35 Console NF",
    "terminal.integrated.smoothScrolling": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "update.releaseTrack": "prerelease",
    "viraTheme.accent": "White",
    "vs-kubernetes": {
        "vs-kubernetes.crd-code-completion": "enabled",
        "vs-kubernetes.ignore-recommendations": true,
        "vscode-kubernetes.helm-path-mac": "~/.vs-kubernetes/tools/helm/darwin-arm64/helm",
        "vscode-kubernetes.kubectl-path-mac": "~/.vs-kubernetes/tools/kubectl/kubectl",
        "vscode-kubernetes.minikube-path-mac": "~/.vs-kubernetes/tools/minikube/darwin-arm64/minikube"
    },
    "window.autoDetectColorScheme": false,
    "window.commandCenter": true,
    "window.zoomLevel": 0,
    "workbench.activityBar.orientation": "vertical",
    "workbench.agentsWindowButton.enabled": false,
    "workbench.colorCustomizations": {
        "[Vira*]": {
            "activityBar.activeBorder": "#FFFFFF",
            "activityBarBadge.background": "#FFFFFF",
            "activityBarBadge.foreground": "#000000",
            "activityBarTop.activeBorder": "#FFFFFF",
            "breadcrumb.activeSelectionForeground": "#FFFFFF",
            "button.background": "#FFFFFF",
            "button.foreground": "#000000",
            "button.hoverBackground": "#FFFFFFcc",
            "chat.avatarForeground": "#FFFFFF",
            "chat.slashCommandForeground": "#FFFFFF",
            "editor.findMatchBorder": "#FFFFFF",
            "editorSuggestWidget.highlightForeground": "#FFFFFF",
            "editorWidget.border": "#FFFFFF",
            "editorWidget.resizeBorder": "#FFFFFF",
            "extensionButton.background": "#FFFFFF14",
            "extensionButton.foreground": "#FFFFFF",
            "extensionButton.hoverBackground": "#FFFFFF33",
            "extensionButton.prominentBackground": "#FFFFFF14",
            "extensionButton.prominentForeground": "#FFFFFF",
            "extensionButton.prominentHoverBackground": "#FFFFFF33",
            "extensionButton.separator": "#FFFFFF33",
            "list.activeSelectionForeground": "#FFFFFF",
            "list.activeSelectionIconForeground": "#FFFFFF",
            "list.highlightForeground": "#FFFFFF",
            "list.inactiveSelectionForeground": "#FFFFFF",
            "list.inactiveSelectionIconForeground": "#FFFFFF",
            "menu.selectionForeground": "#FFFFFF",
            "menubar.selectionForeground": "#FFFFFF",
            "notebook.inactiveFocusedCellBorder": "#FFFFFF80",
            "notificationLink.foreground": "#FFFFFF",
            "panelTitle.activeBorder": "#FFFFFF",
            "pickerGroup.foreground": "#FFFFFF",
            "progressBar.background": "#FFFFFF",
            "sash.hoverBorder": "#FFFFFF80",
            "scrollbarSlider.activeBackground": "#FFFFFF80",
            "selection.background": "#FFFFFF40",
            "settings.modifiedItemIndicator": "#FFFFFF",
            "statusBar.debuggingBackground": "#FFFFFF33",
            "statusBar.debuggingForeground": "#FFFFFF",
            "statusBarItem.remoteBackground": "#FFFFFF14",
            "statusBarItem.remoteForeground": "#FFFFFF",
            "statusBarItem.remoteHoverBackground": "#FFFFFF",
            "statusBarItem.remoteHoverForeground": "#000000",
            "tab.activeBorder": "#FFFFFF",
            "tab.activeBorderTop": "#FFFFFF00",
            "tab.activeModifiedBorder": "#FFFFFF00",
            "tab.unfocusedActiveBorder": "#FFFFFF",
            "tab.unfocusedActiveBorderTop": "#FFFFFF00",
            "textLink.foreground": "#FFFFFF",
            "toolbar.activeBackground": "#FFFFFF26"
        },
        "editor.lineHighlightBackground": "#1073cf2d",
        "editor.lineHighlightBorder": "#9fced11f"
    },
    "workbench.colorTheme": "Black++ Dark Ula",
    "workbench.editor.closeOnFileDelete": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.scrollToSwitchTabs": true,
    "workbench.editor.wrapTabs": true,
    "workbench.iconTheme": "catppuccin-macchiato",
    "workbench.list.smoothScrolling": true,
    "workbench.navigationControl.enabled": false,
    "workbench.productIconTheme": "icons-carbon",
    "workbench.tree.indent": 25,
    "workbench.view.alwaysShowHeaderActions": true
}
