{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "alwaysThinkingEnabled": false,
    "autoUpdatesChannel": "stable",
    "awsAuthRefresh": "aws sso login --profile ai",
    "cleanupPeriodDays": 60,
    "effortLevel": "max",
    "enabledPlugins": {
        "coderabbit@claude-plugins-official": true,
        "codex@openai-codex": true,
        "gopls-lsp@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true
    },
    "env": {
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-4-6-v1",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-4-6",
        "API_TIMEOUT_MS": "1200000",
        "AWS_PROFILE": "ai",
        "AWS_REGION": "us-east-1",
        "BASH_DEFAULT_TIMEOUT_MS": "300000",
        "BASH_MAX_TIMEOUT_MS": "600000",
        "CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS": "1800000",
        "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
        "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
        "CLAUDE_CODE_EFFORT_LEVEL": "max",
        "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
        "CLAUDE_CODE_FORK_SUBAGENT": "1",
        "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
        "CLAUDE_CODE_MAX_RETRIES": "10",
        "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "20",
        "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
        "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "16",
        "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
        "CLAUDE_CODE_USE_BEDROCK": "1",
        "CVE_GUARD_ALLOW": "qdrant/qdrant*",
        "DISABLE_TELEMETRY": "1",
        "GOPROXY": "https://golang.flatt.tech",
        "MAX_MCP_OUTPUT_TOKENS": "50000",
        "NPM_CONFIG_REGISTRY": "https://npm.flatt.tech/",
        "PIP_INDEX_URL": "https://pypi.flatt.tech/simple/",
        "UV_DEFAULT_INDEX": "https://pypi.flatt.tech/simple/"
    },
    "extraKnownMarketplaces": {
        "openai-codex": {
            "source": {
                "repo": "openai/codex-plugin-cc",
                "source": "github"
            }
        }
    },
    "hooks": {
        "Notification": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/notify.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ],
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/secret-guard.sh",
                        "timeout": 5,
                        "type": "command"
                    },
                    {
                        "command": "~/.claude/hooks/dep-install-guard.sh",
                        "timeout": 20,
                        "type": "command"
                    },
                    {
                        "command": "~/.claude/hooks/docker-cve-guard.sh",
                        "timeout": 180,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/memory-recall.sh",
                        "timeout": 15,
                        "type": "command"
                    }
                ],
                "matcher": "startup|resume|clear"
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "command": "echo '{\"cwd\": \"'\"$(pwd)\"'\", \"notification_type\": \"stop\"}' | ~/.claude/notify.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ]
    },
    "includeCoAuthoredBy": false,
    "language": "ja",
    "model": "opus",
